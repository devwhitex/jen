# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here

# (Optional) Test Guild ID for instant slash command updates without 1-hour global cache
GUILD_ID=

# ==========================================
# BOT CUSTOMIZATION
# ==========================================
DEFAULT_PREFIX=!
EMBED_COLOR=#5865F2

# ==========================================
# WEB DASHBOARD CONTROL SYSTEM
# ==========================================
PORT=3000
DASHBOARD_PASSCODE=admin123
